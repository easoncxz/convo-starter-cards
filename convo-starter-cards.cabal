cabal-version: 2.4
name:          convo-starter-cards
version:       0.1.0.0
build-type:    Simple

executable site
  main-is:          site.hs
  build-depends:
    base       >= 4.14 && < 5,
    hakyll     >= 4.15,
    yaml       >= 0.11,
    aeson      >= 2.0,
    text       >= 1.2,
    bytestring >= 0.10,
    filepath   >= 1.4
  default-language: Haskell2010
  ghc-options:      -Wall -threaded

test-suite spec
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:
    base       >= 4.14 && < 5,
    hspec      >= 2.0,
    yaml       >= 0.11,
    aeson      >= 2.0,
    text       >= 1.2,
    bytestring >= 0.10,
    directory  >= 1.3
  default-language: Haskell2010
  ghc-options:      -Wall -threaded
